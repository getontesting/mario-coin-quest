# --- Server ---
PORT=8080
HOST=0.0.0.0
RIFTY_PUBLIC_URL=https://your-domain.com
RIFTY_SESSION_SECRET=change-this-to-a-long-random-string

# --- Telegram (from @BotFather) ---
RIFTY_BOT_TOKEN=123456:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RIFTY_BOT_NAME=mariocoinbot
RIFTY_ADMIN_IDS=123456789,987654321

# Set to false after the bot token is configured (disables the browser demo login).
RIFTY_DEMO_MODE=true

# --- TON / TonAPI ---
RIFTY_TONAPI_KEY=your-tonapi-key
RIFTY_TONAPI_BASE=https://tonapi.io/v2
RIFTY_CHAIN=-239
RIFTY_JETTON_MASTER=EQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RIFTY_TREASURY=UQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
